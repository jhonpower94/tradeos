NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Compose service hostnames
MONGODB_URI=mongodb://mongo:27017/trading-os
REDIS_URL=redis://redis:6379

# REQUIRED: generate strong values before deploy
#   openssl rand -base64 48
#   openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
ENCRYPTION_KEY=

BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_TESTNET=false

# Public site origin (browser Origin header). Use HTTPS in production, e.g. https://tradingos.tech
CORS_ORIGIN=https://tradingos.tech

FEE_RATE=0.001
SCANNER_CONCURRENCY=5
MIN_CONSENSUS_SCORE=75

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# Web Push (run on host: node scripts/ensure-vapid.mjs — then copy keys here)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:trading-os@localhost
